# Local Supabase only. Run `npx supabase start`, then copy its local public key below.
# Never add secret/service-role keys with a VITE_ prefix.
VITE_API_BASE_URL=http://127.0.0.1:8000/api
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
VITE_SUPPORT_WHATSAPP=918000961030

# Server-side FastAPI configuration. Never expose SUPABASE_SECRET_KEY to the browser.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Development-only conveniences (random signing key, TEST bank-credit evidence). Anything but "local" fails closed.
BFP_ENV=local
# Dedicated secret for short-lived signed image URLs (optional locally; required outside local).
PROOF_SIGNING_SECRET=
