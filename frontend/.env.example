# Local Supabase only. Run `npx supabase start`, then copy its local public key below.
# Never add secret/service-role keys with a VITE_ prefix.
# Local dev points at the local FastAPI. Production builds default to the same-origin /api (backend service on Vercel).
VITE_API_BASE_URL=http://127.0.0.1:8000/api
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
VITE_SUPPORT_WHATSAPP=918000961030
# The storefront and the Admin Panel (admin-panel/frontend, which reads this same file) are separate sites.
# Local defaults: store http://localhost:5173, admin http://localhost:5174. On Vercel set the real addresses:
# VITE_STORE_URL=     (admin project: target of its "Store" links)
# VITE_ADMIN_URL=     (storefront project: target of the Owner Admin's "Admin Panel" link)

# Server-side FastAPI configuration. Never expose SUPABASE_SECRET_KEY to the browser.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=http://127.0.0.1:55321/auth/v1/.well-known/jwks.json
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:55322/postgres
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
