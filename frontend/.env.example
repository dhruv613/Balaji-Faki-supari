# Browser settings for the storefront and the Admin Panel (both read this file). Everything here reaches the browser:
# never put database, storage or signing secrets in this file; the API's settings live in the root .env (see ../.env.example).
VITE_API_BASE_URL=http://127.0.0.1:8000/api
# Neon Auth URL of the branch (same value as NEON_AUTH_BASE_URL). Public.
VITE_NEON_AUTH_URL=
VITE_SUPPORT_WHATSAPP=918000961030
# Local defaults: store http://localhost:5173, admin http://localhost:5174. On Vercel set the real addresses:
# VITE_STORE_URL=     (admin project: target of its "Store" links)
# VITE_ADMIN_URL=     (storefront project: target of the Owner Admin's "Admin Panel" link)
