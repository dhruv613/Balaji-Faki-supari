# Local development template. Copy to .env (gitignored) and fill in from the Neon Console or `neon deploy`
# (which writes DATABASE_URL, DATABASE_URL_UNPOOLED, NEON_AUTH_BASE_URL, NEON_AUTH_JWKS_URL and the AWS_* storage keys).
# Never put database or storage credentials in VITE_* variables: those are shipped to the browser.

# ---- Browser (Vite) ----
VITE_API_BASE_URL=http://127.0.0.1:8000/api
# Neon Auth URL of the branch (same value as NEON_AUTH_BASE_URL). Public.
VITE_NEON_AUTH_URL=
VITE_SUPPORT_WHATSAPP=918000961030
# Local defaults: store http://localhost:5173, admin http://localhost:5174. On Vercel set the real addresses:
# VITE_STORE_URL=     (admin project: target of its "Store" links)
# VITE_ADMIN_URL=     (storefront project: target of the Owner Admin's "Admin Panel" link)

# ---- Server (FastAPI) ----
# Pooled Neon connection string (host contains "-pooler"); the direct one is only for schema setup.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Neon Object Storage (S3-compatible, private "assets" bucket)
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
# Long random string (32+ characters); signs short-lived admin links to payment screenshots.
PROOF_SIGNING_SECRET=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
